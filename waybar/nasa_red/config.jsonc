{
    "layer": "top",
    "position": "left",
    "width": 46,
    "margin-top": 12,
    "margin-bottom": 12,
    "margin-left": 10,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/nasa",
        "ext/workspaces",
        "custom/mission"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery",
        "tray",
        "custom/power"
    ],

    "custom/nasa": {
        "format": "N\nA\nS\nA",
        "tooltip-format": "Mango // Houston, we are go.",
        "on-click": "xdg-open https://apod.nasa.gov/apod/astropix.html"
    },

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "sort-by-id": true
    },

    "custom/mission": {
        "format": "T+\n{}",
        "exec": "uptime -p | sed -e 's/up //' -e 's/ hours\\?/h/g' -e 's/ minutes\\?/m/g' -e 's/ days\\?/d/g' -e 's/ weeks\\?/w/g' -e 's/, /\\n/g'",
        "interval": 30,
        "tooltip-format": "Mission elapsed time"
    },

    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "<tt>{:%A %d %B %Y}\n\n{calendar}</tt>"
    },

    "cpu": {
        "format": "\n{usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "\n{percentage}%",
        "interval": 2,
        "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid}\n{ipaddr} · {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "offline",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "tooltip-format": "{volume}%",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}\n{capacity}%",
        "format-charging": "\n{capacity}%",
        "format-plugged": "\n{capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo} · {power:0.1f}W"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip-format": "Abort mission"
    }
}
