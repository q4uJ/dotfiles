{
    "layer": "top",
    "position": "top",
    "margin-top": 2,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    "modules-left": [ 
        "cpu", 
        "memory",
        "ext/workspaces"
    ],
    "modules-right": [
        "battery", 
        "clock", 
        "custom/power"
    ],

    "custom/distro_logo": {
        "format": "",
        "tooltip": false
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 2
    },

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "sort-by-id": true
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "clock": {
        "format": "  {:%d.%m  |  %H:%M}",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip": false
    }
}
